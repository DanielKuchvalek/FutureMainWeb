DirectoryIndex index.html
Options -Indexes

AddType image/webp .webp
AddType font/woff2 .woff2
AddType image/svg+xml .svg
AddType video/webm .webm
AddType video/mp4 .mp4

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(webp|png|jpe?g|svg|woff2|mp4|webm)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  # styly, skripty a stránku si prohlížeč pokaždé ověří (při beze změny odpoví server jen 304),
  # takže po úpravě webu nikdo nevidí starou verzi z mezipaměti
  <FilesMatch "\.(css|js|html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# Úložiště zpráv a interní soubory nejsou dostupné z webu.
RedirectMatch 403 (^|/)storage(/|$)
RedirectMatch 403 (^|/)\.git(/|$)
RedirectMatch 403 (^|/)_zdroje(/|$)
